# 即時後端：fastapi_wss | firebase
MIBAND_BACKEND=fastapi_wss

# FastAPI WSS（通常可留空，前端會用目前網站同源 /ws）
# MIBAND_WS_URL=ws://localhost:18080/ws

# Firebase（MIBAND_BACKEND=firebase 時必填；這些是前端公開設定）
# MIBAND_FIREBASE_API_KEY=
# MIBAND_FIREBASE_AUTH_DOMAIN=
# MIBAND_FIREBASE_DATABASE_URL=
# MIBAND_FIREBASE_PROJECT_ID=
# MIBAND_FIREBASE_APP_ID=

# Lovense 手動震動滑桿（三個都要有，面板才會出現；沒設定時心率功能不變）
# Developer Token 只留在伺服器，不要寫進前端
# LOVENSE_DEVELOPER_TOKEN=
# LOVENSE_PLATFORM=
# LOVENSE_SESSION_SECRET=
